# Copy to .env.local and fill in your keys. This file is gitignored.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=cerebras,groq,huggingface,openrouter

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=gpt-oss-120b

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

HF_TOKEN=your-huggingface-token
HF_MODEL=Qwen/Qwen3-32B

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Legacy aliases still supported:
# DOCNA_AI_PROVIDER=gemini
# DOCNA_AI_FALLBACK_PROVIDERS=cerebras,groq,huggingface,openrouter
