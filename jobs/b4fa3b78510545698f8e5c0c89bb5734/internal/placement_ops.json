        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 133
      }
    },
    "text": "Holistic development refers to the transformation from animal consciousness (living solely for physical facilities) to human consciousness (living with right understanding, fulfillment in relationships, and physical facilities in the correct priority). The role of education\u2013sanskar is to facilitate and enable this transformation in human beings.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 132
      }
    },
    "review_flags": []
  },
  {
