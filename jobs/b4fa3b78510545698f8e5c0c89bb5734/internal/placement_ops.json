      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 48
      }
    },
    "text": "To fill the need for continuous happiness and fulfilment, people generally make efforts to accumulate more physical facilities and material goods, assuming that physical facilities alone will provide complete satisfaction.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 48
