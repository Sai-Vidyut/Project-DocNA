      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 48
      }
    },
    "text": "It is getting wider rather than getting filled, because physical facility alone is not adequate for human beings and cannot fulfill the requirement for right understanding in the self and mutual fulfilment in relationships.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 48
