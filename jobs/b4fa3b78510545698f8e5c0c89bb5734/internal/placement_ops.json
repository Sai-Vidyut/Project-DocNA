        "body_index": 123
      }
    },
    "text": "Based on today's discussion, the role in the education system is to facilitate holistic development through education-sanskar, enabling the transformation from animal consciousness to human consciousness by developing right understanding in the self, right relationship with human beings, and right physical facility with nature.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 122
