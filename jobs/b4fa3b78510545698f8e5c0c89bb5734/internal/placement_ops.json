    "task_id": "task_0017",
    "strategy": "fill_existing",
    "target": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 138
      }
    },
    "text": "Living with Animal Consciousness means giving sole priority to physical facilities, assuming they are both necessary and adequate. Living with Human Consciousness acknowledges that physical facilities are necessary but not sufficient for humans. Human Consciousness prioritizes all three requirements in the correct order: 1) Right Understanding in the self, 2) Fulfillment in Relationships with human beings, and 3) Physical Facility with nature.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 137
      }
