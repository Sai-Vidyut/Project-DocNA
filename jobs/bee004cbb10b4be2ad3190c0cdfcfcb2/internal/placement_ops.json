        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 143
      }
    },
    "text": "Yes, the basic human aspiration is continuous happiness and prosperity.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 143
      }
    },
    "review_flags": []
  },
  {
