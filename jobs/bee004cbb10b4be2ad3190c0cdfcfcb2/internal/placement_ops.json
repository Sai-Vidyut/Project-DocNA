      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 48
      }
    },
    "text": "To fill the gap and achieve happiness, most effort is currently directed toward accumulating more physical facilities, assuming physical wealth alone will bring complete satisfaction.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 48
