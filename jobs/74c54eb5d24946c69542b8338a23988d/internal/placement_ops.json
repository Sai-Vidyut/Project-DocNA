    ]
  },
  {
    "op_id": "op_0005",
    "task_id": "task_0005",
    "strategy": "insert_below",
    "target": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 46
      }
    },
    "text": "Without right understanding, the gap tends to get wider despite accumulating physical facilities; however, through self-exploration and right understanding, the gap gradually gets filled.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 46
      }
    },
    "review_flags": [
      "shared_answer_space"
    ]
  },
  {
