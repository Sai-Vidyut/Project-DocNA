    "strategy": "fill_existing",
    "target": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 57
      }
    },
    "text": "Most time and effort is invested in acquiring physical facilities rather than for fulfilment in relationships.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 56
