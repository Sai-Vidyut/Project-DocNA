      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 54
      }
    },
    "text": "More due to lack of fulfilment in relationship.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 54
      }
    },
    "review_flags": []
  },
  {
