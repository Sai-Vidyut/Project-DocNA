      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 62
      }
    },
    "text": "Right understanding gives clarity about human purpose and harmony, which leads to fulfilment in relationships and proper utilization of physical facilities.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 62
      }
    },
    "review_flags": []
  },
