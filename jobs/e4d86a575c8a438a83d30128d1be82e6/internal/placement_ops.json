    "strategy": "fill_existing",
    "target": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 133
      }
    },
    "text": "Holistic development refers to the transformation from animal consciousness (focusing only on physical facility) to human consciousness (balancing physical facility, relationships with others, and right understanding within the self). The role of education\u2013sanskar is to facilitate this transformative process by prioritizing these three elements, enabling individuals to transcend mere physical needs and cultivate a harmonious existence with nature, society, and self-awareness.",
    "style_clone_from": {
      "adapter": "docx",
      "payload": {
        "v": 1,
        "kind": "paragraph",
        "part": "word/document.xml",
        "body_index": 132
      }
    },
    "review_flags": []
  },
